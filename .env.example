# Server
MCP_HOST=127.0.0.1
MCP_PORT=8787
MCP_PATH=/mcp

# observe | workspace | full
MCP_MODE=workspace

# Colon-separated absolute roots. Defaults to ~/code:~/Documents:~/Downloads
MCP_ALLOWED_ROOTS=/home/YOUR_USER/code:/home/YOUR_USER/Documents:/home/YOUR_USER/Downloads

# Secrets remain blocked even in full mode unless explicitly enabled.
MCP_ALLOW_SECRETS=0

# Optional static bearer token for local Inspector/API testing.
# Do not rely on this instead of OAuth for a public ChatGPT endpoint.
MCP_AUTH_TOKEN=

# Limits
MCP_MAX_READ_BYTES=1048576
MCP_MAX_OUTPUT_BYTES=262144
MCP_COMMAND_TIMEOUT_MS=120000
MCP_RATE_LIMIT_PER_MINUTE=120

# State and audit
MCP_STATE_DIR=/home/YOUR_USER/.local/state/mcp-free
MCP_LOG_LEVEL=info

# Desktop helpers
YDOTOOL_SOCKET=/run/user/1000/.ydotool_socket
